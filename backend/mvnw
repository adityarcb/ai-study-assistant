#!/bin/sh
# Maven Wrapper script
# This script downloads and runs the Maven Wrapper JAR

set -e

MAVEN_WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES=".mvn/wrapper/maven-wrapper.properties"
MAVEN_WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"

# Determine the project base directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Check if Maven wrapper JAR exists, download if not
if [ ! -f "$MAVEN_WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper..."
    mkdir -p .mvn/wrapper
    if command -v curl > /dev/null 2>&1; then
        curl -sL -o "$MAVEN_WRAPPER_JAR" "$MAVEN_WRAPPER_URL"
    elif command -v wget > /dev/null 2>&1; then
        wget -q -O "$MAVEN_WRAPPER_JAR" "$MAVEN_WRAPPER_URL"
    else
        echo "Error: Neither curl nor wget found. Cannot download Maven Wrapper."
        echo "Please install Maven manually: https://maven.apache.org/install.html"
        echo "Or run: mvn spring-boot:run"
        exit 1
    fi
fi

# Run Maven
exec java -jar "$MAVEN_WRAPPER_JAR" "$@"
